{
  "name": "swarm-draw",
  "version": "0.1.1",
  "description": "Design-mode overlay: a flock of agent cursors draws a page in real time - drag-out frames, wireframe blocks, typed copy, then colour - with a live layer HUD.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./react": "./src/react.js",
    "./vue": "./src/vue.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "npx --yes serve .",
    "build:site": "node scripts/build-site.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "agent",
    "overlay",
    "figma",
    "skeleton",
    "demo",
    "swarm",
    "wireframe",
    "react",
    "vue",
    "animation"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.45",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "homepage": "https://yunhai-dev.github.io/swarm-draw/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunhai-dev/swarm-draw.git"
  },
  "bugs": {
    "url": "https://github.com/yunhai-dev/swarm-draw/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
